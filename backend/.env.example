# Server
NODE_ENV=development
PORT=5000

# CORS comma-separated origins (Vite default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# Database
MONGO_URI=

# Auth
SALT_ROUNDS=10

# JWT (use strong random secrets in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional: JWT_ACCESS_EXPIRES=15m  JWT_REFRESH_EXPIRES=7d

# AI / RAG microservice (Python FastAPI)
RAG_SERVICE_URL=http://localhost:8001
# Optional: request timeout in ms (default 30000)
# RAG_REQUEST_TIMEOUT_MS=30000
